<Window x:Class="ClassifyImage.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="图片分类器" Width="1180" Height="780" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterScreen"
 FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" Foreground="#1E293B"
 KeyDown="Window_KeyDown" KeyUp="Window_KeyUp" PreviewKeyDown="Window_PreviewKeyDown" Deactivated="Window_Deactivated">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Border Background="#F4F6FA"><Grid Margin="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Style="{StaticResource Card}" Padding="10,6" Margin="0,0,0,8">
   <Border.Resources>
    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
     <Setter Property="Padding" Value="8,5"/>
     <Setter Property="MinHeight" Value="32"/>
    </Style>
   </Border.Resources>
   <DockPanel>
    <Button x:Name="setting_btn" DockPanel.Dock="Right" Content="配置" Click="setting_btn_Click" ToolTip="分类目录与软件选项（F2）" Focusable="False"/>
  <Border x:Name="cropToolbar" DockPanel.Dock="Right" Margin="12,0,12,0" Visibility="Collapsed">
   <StackPanel Orientation="Horizontal">
    <StackPanel x:Name="cropSizePanel" Orientation="Horizontal" Visibility="Collapsed">
     <TextBlock Text="裁剪像素 " VerticalAlignment="Center"/><TextBox x:Name="cropWidthInput" Width="64"/><TextBlock Text=" × " VerticalAlignment="Center"/><TextBox x:Name="cropHeightInput" Width="64"/>
     <Button Content="应用" Click="ApplyCropSize_Click" Margin="8,0,0,0" Focusable="False"/>
    </StackPanel>
    <Button x:Name="btnConfirmCrop" Content="保存裁剪" Style="{StaticResource PrimaryButton}" Click="btnConfirmCrop_Click" Visibility="Collapsed" Margin="12,0,6,0" Focusable="False"/>
    <Button x:Name="btnCancelCrop" Content="取消" Click="btnCancelCrop_Click" Visibility="Collapsed" ToolTip="Esc" Focusable="False"/>
   </StackPanel>
  </Border>
    <WrapPanel Orientation="Horizontal">
     <StackPanel Orientation="Horizontal">
     <Button x:Name="open_file_folders_btn" Style="{StaticResource PrimaryButton}" Content="打开文件夹" Click="open_file_folders_btn_Click" Margin="0,0,8,0" ToolTip="Ctrl + Shift + O" Focusable="False"/>
     <Button x:Name="open_img_btn" Content="打开图片" Click="open_img_btn_Click" ToolTip="Ctrl + O" Focusable="False"/>
     </StackPanel>
     <StackPanel x:Name="imageBrowseTools" Orientation="Horizontal">
     <Border Width="1" Background="#E2E8F0" Margin="12,4"/>
     <StackPanel Orientation="Horizontal" x:Name="imageActions">
      <Button x:Name="edit_img_btn" Content="裁剪" Click="edit_img_btn_Click" ToolTip="E" Margin="0,0,6,0" Focusable="False"/>
      <Button x:Name="copy_clipboard_btn" Content="复制" Click="copy_clipboard_btn_Click" ToolTip="复制图片（Ctrl + C）" Margin="0,0,6,0" Focusable="False"/>
      <Button x:Name="externalOpenButton" Content="外部打开" Click="open_explorer_btn_Click" Focusable="False"/>
     </StackPanel>
     <Border Width="1" Background="#E2E8F0" Margin="8,4"/>
     <StackPanel Orientation="Horizontal">
      <Button x:Name="left_btn" Content="‹ 上一张" Click="NavigationButton_Click" ToolTip="←" Focusable="False" Margin="0,0,6,0"/>
      <Button x:Name="right_btn" Content="下一张 ›" Click="NavigationButton_Click" ToolTip="→" Focusable="False"/>
     </StackPanel>
     <Border Width="1" Background="#E2E8F0" Margin="8,4"/>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Button x:Name="img_minus" Content="−" Click="ZoomButton_Click" Width="28" Padding="0" Focusable="False"/>
      <Slider x:Name="zoomSlider" Width="70" Margin="6,0" VerticalAlignment="Center" Maximum="400" Minimum="25" Value="100" SmallChange="25" LargeChange="50" ToolTip="100% 为适应窗口；Ctrl + 滚轮缩放" ValueChanged="ZoomSlider_ValueChanged"/>
      <Button x:Name="img_plus" Content="+" Click="ZoomButton_Click" Width="28" Padding="0" Focusable="False"/>
      <Button Width="54" Margin="6,0,8,0" Click="ResetZoom_Click" ToolTip="恢复适应窗口" Focusable="False">
       <TextBlock Text="{Binding ElementName=zoomSlider, Path=Value, StringFormat={}{0:0}%}"/>
      </Button>
     </StackPanel>
     </StackPanel>
    </WrapPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="0">
    <Grid>
     <Border Background="#E9EDF4" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
      <Grid>
       <StackPanel x:Name="emptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock x:Name="emptyStateTitle" Text="准备好下一组图片了吗？" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock x:Name="emptyStateHint" Text="打开图片文件夹，使用数字键快速分类" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,20" HorizontalAlignment="Center"/>
        <Button Content="打开文件夹" Style="{StaticResource PrimaryButton}" Click="open_file_folders_btn_Click" HorizontalAlignment="Center" Focusable="False"/>
       </StackPanel>
       <ScrollViewer x:Name="imageViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" SizeChanged="ImageViewer_SizeChanged" PreviewMouseWheel="ImageViewer_PreviewMouseWheel"
                     PreviewMouseMove="ImageViewer_PreviewMouseMove" PreviewMouseLeftButtonUp="ImageViewer_PreviewMouseLeftButtonUp"
                     LostMouseCapture="ImageViewer_LostMouseCapture" ScrollChanged="ImageViewer_ScrollChanged">
        <Grid x:Name="imageSurface" HorizontalAlignment="Center" VerticalAlignment="Center">
         <Grid.LayoutTransform><ScaleTransform x:Name="imageScale"/></Grid.LayoutTransform>
         <Image Source="res/MyGO_easter_egg.jpg" Name="now_display_img" Stretch="Fill" MouseLeftButtonDown="DisplayImage_MouseLeftButtonDown"/>
            <Canvas x:Name="cropCanvas"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Collapsed"
                    Background="Transparent">
                <Rectangle x:Name="cropRectangle"
                           Stroke="Red"
                           Fill="Transparent"
                           StrokeThickness="2"
                           Visibility="Collapsed"
                           MouseLeftButtonDown="CropRectangle_MouseLeftButtonDown"
                           MouseMove="CropRectangle_MouseMove"
                           MouseLeftButtonUp="CropRectangle_MouseLeftButtonUp"/>

                <!-- 8个调整大小的Thumb -->
                <Thumb x:Name="topLeftThumb"
                       Width="10"
                       Height="10"
                       Cursor="SizeNWSE"
                       DragDelta="ResizeThumb_DragDelta"
                       Tag="TopLeft"/>
                <Thumb x:Name="topThumb"
                       Width="10"
                       Height="10"
                       Cursor="SizeNS"
                       DragDelta="ResizeThumb_DragDelta"
                       Tag="Top"/>
                <Thumb x:Name="topRightThumb"
                       Width="10"
                       Height="10"
                       Cursor="SizeNESW"
                       DragDelta="ResizeThumb_DragDelta"
                       Tag="TopRight"/>
                <Thumb x:Name="leftThumb"
                       Width="10"
                       Height="10"
                       Cursor="SizeWE"
                       DragDelta="ResizeThumb_DragDelta"
                       Tag="Left"/>
                <Thumb x:Name="rightThumb"
                       Width="10"
                       Height="10"
                       Cursor="SizeWE"
                       DragDelta="ResizeThumb_DragDelta"
                       Tag="Right"/>
                <Thumb x:Name="bottomLeftThumb"
                       Width="10"
                       Height="10"
                       Cursor="SizeNESW"
                       DragDelta="ResizeThumb_DragDelta"
                       Tag="BottomLeft"/>
                <Thumb x:Name="bottomThumb"
                       Width="10"
                       Height="10"
                       Cursor="SizeNS"
                       DragDelta="ResizeThumb_DragDelta"
                       Tag="Bottom"/>
                <Thumb x:Name="bottomRightThumb"
                       Width="10"
                       Height="10"
                       Cursor="SizeNWSE"
                       DragDelta="ResizeThumb_DragDelta"
                       Tag="BottomRight"/>
            </Canvas>
        </Grid>
       </ScrollViewer>
      </Grid>
     </Border>
    </Grid>
   </Border>
   <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel>
      <TextBlock Text="分类目录" Style="{StaticResource SectionTitle}"/>
      <TextBlock x:Name="classificationHint" Text="按数字键或点击类别进行分类" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
     </StackPanel>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="categoryPanel"/></ScrollViewer>
     <StackPanel Grid.Row="2" Margin="0,12,0,0">
      <Separator Background="#E2E8F0"/>
      <CheckBox x:Name="quickAutoNext" Content="分类后自动下一张" Checked="QuickOption_Changed" Unchecked="QuickOption_Changed" Focusable="False"/>
      <CheckBox x:Name="quickMultiCategory" Content="多类别复制模式" Checked="QuickOption_Changed" Unchecked="QuickOption_Changed" Focusable="False"/>
      <TextBlock Text="目录设置在右上角「配置」中修改" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
     </StackPanel>
    </Grid>
   </Border>
  </Grid>
  <Border Grid.Row="2" Margin="0,6,0,0">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="fileNameText" Text="尚未打开图片" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
    <TextBlock Grid.Column="1" x:Name="statusText" Text="0–9 分类 · ← → 翻页" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
    <StackPanel Grid.Column="2" Orientation="Horizontal">
     <TextBlock x:Name="imageCounter" Text="" Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0"/>
     <TextBlock Name="now_img_resolution_text" ToolTip="图片像素尺寸（宽 × 高）" Margin="16,0">
      <TextBlock.Text><MultiBinding StringFormat="{}{0}x{1}" FallbackValue=""><Binding ElementName="now_display_img" Path="Source.PixelWidth"/><Binding ElementName="now_display_img" Path="Source.PixelHeight"/></MultiBinding></TextBlock.Text>
     </TextBlock>
     <TextBlock Name="now_img_size_text" Foreground="{StaticResource MutedBrush}"/>
    </StackPanel>
   </Grid>
  </Border>

 </Grid></Border>
</Window>
