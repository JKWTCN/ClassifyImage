<Window x:Class="ClassifyImage.SettingWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="分类器配置" Width="760" Height="720" MinWidth="620" MinHeight="500" WindowStartupLocation="CenterOwner"
 FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" Foreground="#1E293B">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Border Background="#F4F6FA"><Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,16"><TextBlock Text="配置" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="设置自动保存，关闭窗口即可继续分类" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/></StackPanel>
  <TabControl x:Name="settingsTabs" Grid.Row="1" Background="Transparent" BorderThickness="0">
   <TabItem Header="  分类目录  ">
    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,8"><TextBlock Text="数字键对应的保存目录" Style="{StaticResource SectionTitle}"/><TextBlock Text="支持主键盘与小键盘；长路径可悬停查看" Foreground="{StaticResource MutedBrush}"/></StackPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
<Border BorderBrush="#EDF1F7" BorderThickness="0,0,0,1" Padding="0,8"><Grid>
 <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <Border Background="#EFF6FF" CornerRadius="5" Width="28" Height="28" HorizontalAlignment="Left"><TextBlock Text="0" Foreground="#2563EB" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
 <TextBlock Grid.Column="1" Name="path_0_text" VerticalAlignment="Center" Margin="8,0,12,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
 <Button Grid.Column="2" Name="open_btn_0" Content="选择目录" Click="ChooseSaveClick"/>
 </Grid></Border>
<Border BorderBrush="#EDF1F7" BorderThickness="0,0,0,1" Padding="0,8"><Grid>
 <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <Border Background="#EFF6FF" CornerRadius="5" Width="28" Height="28" HorizontalAlignment="Left"><TextBlock Text="1" Foreground="#2563EB" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
 <TextBlock Grid.Column="1" Name="path_1_text" VerticalAlignment="Center" Margin="8,0,12,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
 <Button Grid.Column="2" Name="open_btn_1" Content="选择目录" Click="ChooseSaveClick"/>
 </Grid></Border>
<Border BorderBrush="#EDF1F7" BorderThickness="0,0,0,1" Padding="0,8"><Grid>
 <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <Border Background="#EFF6FF" CornerRadius="5" Width="28" Height="28" HorizontalAlignment="Left"><TextBlock Text="2" Foreground="#2563EB" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
 <TextBlock Grid.Column="1" Name="path_2_text" VerticalAlignment="Center" Margin="8,0,12,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
 <Button Grid.Column="2" Name="open_btn_2" Content="选择目录" Click="ChooseSaveClick"/>
 </Grid></Border>
<Border BorderBrush="#EDF1F7" BorderThickness="0,0,0,1" Padding="0,8"><Grid>
 <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <Border Background="#EFF6FF" CornerRadius="5" Width="28" Height="28" HorizontalAlignment="Left"><TextBlock Text="3" Foreground="#2563EB" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
 <TextBlock Grid.Column="1" Name="path_3_text" VerticalAlignment="Center" Margin="8,0,12,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
 <Button Grid.Column="2" Name="open_btn_3" Content="选择目录" Click="ChooseSaveClick"/>
 </Grid></Border>
<Border BorderBrush="#EDF1F7" BorderThickness="0,0,0,1" Padding="0,8"><Grid>
 <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <Border Background="#EFF6FF" CornerRadius="5" Width="28" Height="28" HorizontalAlignment="Left"><TextBlock Text="4" Foreground="#2563EB" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
 <TextBlock Grid.Column="1" Name="path_4_text" VerticalAlignment="Center" Margin="8,0,12,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
 <Button Grid.Column="2" Name="open_btn_4" Content="选择目录" Click="ChooseSaveClick"/>
 </Grid></Border>
<Border BorderBrush="#EDF1F7" BorderThickness="0,0,0,1" Padding="0,8"><Grid>
 <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <Border Background="#EFF6FF" CornerRadius="5" Width="28" Height="28" HorizontalAlignment="Left"><TextBlock Text="5" Foreground="#2563EB" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
 <TextBlock Grid.Column="1" Name="path_5_text" VerticalAlignment="Center" Margin="8,0,12,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
 <Button Grid.Column="2" Name="open_btn_5" Content="选择目录" Click="ChooseSaveClick"/>
 </Grid></Border>
<Border BorderBrush="#EDF1F7" BorderThickness="0,0,0,1" Padding="0,8"><Grid>
 <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <Border Background="#EFF6FF" CornerRadius="5" Width="28" Height="28" HorizontalAlignment="Left"><TextBlock Text="6" Foreground="#2563EB" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
 <TextBlock Grid.Column="1" Name="path_6_text" VerticalAlignment="Center" Margin="8,0,12,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
 <Button Grid.Column="2" Name="open_btn_6" Content="选择目录" Click="ChooseSaveClick"/>
 </Grid></Border>
<Border BorderBrush="#EDF1F7" BorderThickness="0,0,0,1" Padding="0,8"><Grid>
 <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <Border Background="#EFF6FF" CornerRadius="5" Width="28" Height="28" HorizontalAlignment="Left"><TextBlock Text="7" Foreground="#2563EB" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
 <TextBlock Grid.Column="1" Name="path_7_text" VerticalAlignment="Center" Margin="8,0,12,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
 <Button Grid.Column="2" Name="open_btn_7" Content="选择目录" Click="ChooseSaveClick"/>
 </Grid></Border>
<Border BorderBrush="#EDF1F7" BorderThickness="0,0,0,1" Padding="0,8"><Grid>
 <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <Border Background="#EFF6FF" CornerRadius="5" Width="28" Height="28" HorizontalAlignment="Left"><TextBlock Text="8" Foreground="#2563EB" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
 <TextBlock Grid.Column="1" Name="path_8_text" VerticalAlignment="Center" Margin="8,0,12,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
 <Button Grid.Column="2" Name="open_btn_8" Content="选择目录" Click="ChooseSaveClick"/>
 </Grid></Border>
<Border BorderBrush="#EDF1F7" BorderThickness="0,0,0,1" Padding="0,8"><Grid>
 <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <Border Background="#EFF6FF" CornerRadius="5" Width="28" Height="28" HorizontalAlignment="Left"><TextBlock Text="9" Foreground="#2563EB" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
 <TextBlock Grid.Column="1" Name="path_9_text" VerticalAlignment="Center" Margin="8,0,12,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
 <Button Grid.Column="2" Name="open_btn_9" Content="选择目录" Click="ChooseSaveClick"/>
 </Grid></Border>
      </StackPanel></ScrollViewer>
     </Grid>
    </Border>
   </TabItem>
   <TabItem Header="  操作与显示  ">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
     <StackPanel>
      <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel>
       <TextBlock Text="分类行为" Style="{StaticResource SectionTitle}"/>
       <CheckBox Name="auto_next_check" Content="分类完成后自动切换下一张" Checked="HandleCheck" Unchecked="HandleUnchecked"/>
       <CheckBox Name="mut_kind_check" Content="多类别复制：同时按住多个数字键分类" Checked="HandleCheck" Unchecked="HandleUnchecked"/>
       <TextBlock Text="单类别会移动图片；多类别会复制到所选目录并保留原图。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
       <CheckBox Name="default_path_check" Content="手动向右翻页时，将未分类图片移动到默认目录" Checked="HandleCheck" Unchecked="HandleUnchecked" Margin="0,18,0,10"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Name="default_path" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <Button Grid.Column="1" Name="choose_default_path" Content="选择目录" Click="choose_default_path_Click"/>
       </Grid>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel>
       <TextBlock Text="浏览与窗口" Style="{StaticResource SectionTitle}"/>
       <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
        <TextBlock Text="打开文件夹时的排序" VerticalAlignment="Center"/>
        <ComboBox Grid.Column="1" Name="file_order_combo" SelectionChanged="file_order_combo_SelectionChanged">
         <ComboBoxItem Content="创建时间降序"/><ComboBoxItem Content="创建时间升序"/><ComboBoxItem Content="文件名降序"/><ComboBoxItem Content="文件名升序"/>
         <ComboBoxItem Content="大小降序"/><ComboBoxItem Content="大小升序"/><ComboBoxItem Content="修改时间降序"/><ComboBoxItem Content="修改时间升序"/>
        </ComboBox>
       </Grid>
       <CheckBox Name="control_main_setting_windows_check" Content="配置窗口打开时，允许操作主窗口" Checked="HandleCheck" Unchecked="HandleUnchecked"/>
       <CheckBox Name="MyGO_easter_egg_check" Content="启动时显示彩蛋图片" Checked="HandleCheck" Unchecked="HandleUnchecked"/>
      </StackPanel></Border>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="  关于  ">
    <Border Style="{StaticResource Card}" Margin="0,12,0,0"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
     <Image Source="res/face.jpg" Width="120" Height="120" Stretch="Uniform" Margin="0,0,0,20"/>
     <TextBlock Text="图片分类器" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/>
     <TextBlock Text="@浮云战争" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,8,0,24"/>
     <TextBlock HorizontalAlignment="Center" Margin="0,6">B站：<Hyperlink Name="bilibili_url_hyperlink" NavigateUri="https://space.bilibili.com/283390377" RequestNavigate="Hyperlink_RequestNavigate">浮云战争</Hyperlink></TextBlock>
     <TextBlock HorizontalAlignment="Center" Margin="0,6">GitHub：<Hyperlink Name="github_url_hyperlink" NavigateUri="https://github.com/JKWTCN" RequestNavigate="Hyperlink_RequestNavigate">JKWTCN</Hyperlink></TextBlock>
    </StackPanel></Border>
   </TabItem>
  </TabControl>
  <Button Grid.Row="2" Content="完成" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Width="90" Margin="0,16,0,0" Click="CloseSettings_Click" IsCancel="True"/>
 </Grid></Border>
</Window>
